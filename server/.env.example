MONGODB_URI=mongodb+srv://<user>:<password>@<cluster-host>/travel_app?retryWrites=true&w=majority
JWT_SECRET=replace-with-a-long-random-string
CRON_SECRET=replace-with-another-long-random-string
PORT=5000
# Optional: use a different database on the same cluster (e.g. for local development)
# MONGODB_DB=travel_app_dev
# Optional: set to off to disable visitor sandboxes
# DEMO_MODE=on
NODE_ENV=development

# Demo account passwords used by `npm run seed` (never commit real values)
SEED_ADMIN_PASSWORD=choose-a-strong-password
SEED_TRAVELLER_PASSWORD=choose-a-strong-password
